# ESPN session cookies, used as the fallback when a caller (e.g. Discord) doesn't supply
# its own. Log into espn.com, open devtools -> Application -> Cookies -> fantasy.espn.com.
ESPN_S2=
SWID=

GOOGLE_API_KEY=
OPENAI_API_KEY=

DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# Base URL of the deployed fantasy-ui frontend. success/cancel/portal all return there;
# billing.py appends ?session_id=... to BILLING_SUCCESS_URL itself.
BILLING_SUCCESS_URL=https://fantasy-ui-5jf1.onrender.com
BILLING_CANCEL_URL=https://fantasy-ui-5jf1.onrender.com
BILLING_PORTAL_RETURN_URL=https://fantasy-ui-5jf1.onrender.com

# Must be the exact frontend origin, not "*" - browsers reject "*" when allow_credentials=True.
CORS_ORIGINS=https://fantasy-ui-5jf1.onrender.com

# Optional overrides - uncomment to deviate from the code defaults.
# FANTASY_AGENT_MODEL=gemini-3.8-flash
# FANTASY_AGENT_OPENAI_IMAGE_MODEL=gpt-image-2
