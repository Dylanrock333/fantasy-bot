#!/bin/sh
# Strips any AI-attribution trailer from commit messages before they're
# finalized - this repo is public, so a Claude/Codex/agent session link or
# co-author line must never land in history. Enforced here (not just by
# asking the agent nicely) so it holds regardless of which tool/session
# writes the commit.
#
# Enable with: git config core.hooksPath .githooks

MSG_FILE="$1"

sed -i \
  -e '/^Co-Authored-By: Claude/d' \
  -e '/^Claude-Session:/d' \
  -e '/^🤖 Generated with/d' \
  "$MSG_FILE"

# Trim trailing blank lines left behind by the deletions above.
sed -i -e :a -e '/^\n*$/{$d;N;ba' -e '}' "$MSG_FILE"
